# Put these in Vercel > Project > Settings > Environment Variables (NOT in GitHub)
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# One-time key to create the owner account at /setup. Remove it after setup.
SETUP_KEY=choose-a-long-random-phrase
# Optional: hidden email domain used behind usernames (no emails are ever sent)
LOGIN_DOMAIN=weighbridge.app
